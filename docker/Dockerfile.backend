FROM ubuntu:24.04 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -o Acquire::Retries=5 update \
 && apt-get -o Acquire::Retries=5 install -y --no-install-recommends ca-certificates \
 && update-ca-certificates \
 && sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources \
 && apt-get -o Acquire::Retries=5 update \
 && apt-get -o Acquire::Retries=5 install -y --no-install-recommends build-essential cmake python3-dev python3-venv libpq-dev libpqxx-dev nlohmann-json3-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-lock.txt requirements-v3-lock.txt pyproject.toml ./
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r requirements-v3-lock.txt
COPY . .
RUN cmake -S . -B build-v3 -DLIBRACORE_V2=ON -DCMAKE_BUILD_TYPE=Release -DPython3_EXECUTABLE=/opt/venv/bin/python -Dpybind11_DIR=$(/opt/venv/bin/python -m pybind11 --cmakedir) && cmake --build build-v3 --parallel 2
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -o Acquire::Retries=5 update \
 && apt-get -o Acquire::Retries=5 install -y --no-install-recommends ca-certificates \
 && update-ca-certificates \
 && sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources \
 && apt-get -o Acquire::Retries=5 update \
 && apt-get -o Acquire::Retries=5 install -y --no-install-recommends python3 libpqxx-7.8t64 libpq5 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10001 libra
WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY --from=build /app/build-v3/python /app/build-v3/python
COPY --from=build /app/python /app/python
COPY --from=build /app/database /app/database
COPY --from=build /app/.env.example /app/.env.example
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/app/python:/app/build-v3/python API_HOST=0.0.0.0 API_PORT=8000
RUN mkdir -p /app/var/media && chown libra:libra /app/var/media
USER libra
EXPOSE 8000
CMD ["python","-m","libracore_api.v3.run"]
