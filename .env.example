LIBRACORE_ENV=development
LIBRACORE_LOG_LEVEL=INFO
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=libracore
POSTGRES_USER=libracore
POSTGRES_PASSWORD=libracore_dev_password
# Leave URLs blank to derive them from POSTGRES_* (including URL-escaped passwords).
DATABASE_URL=
TEST_POSTGRES_DB=libracore_test
TEST_DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=8000
AI_ENABLED=true
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_FALLBACK_ON_ERROR=false
AI_WRITE_ACTIONS_ENABLED=true
AI_REQUIRE_CONFIRMATION=true
RUN_LIVE_AI_TESTS=false

# V3 same-origin browser URL; HTTPS is mandatory in production.
PUBLIC_ORIGIN=http://localhost:5173

# Durable local book covers; back up this directory with PostgreSQL.
MEDIA_ROOT=var/media
